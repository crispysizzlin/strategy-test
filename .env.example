# AVRPE Environment Variables
# Copy to .env and fill in your values
# Add these as Cursor Secrets at cursor.com/dashboard for cloud agents

# Schwab Developer API (required for live trading)
# Get access at: https://developer.schwab.com
SCHWAB_API_KEY=your_schwab_app_key_here
SCHWAB_APP_SECRET=your_schwab_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/
SCHWAB_TOKEN_PATH=./schwab_token.json
SCHWAB_ACCOUNT_NUMBER=your_full_account_number

# FRED API (free, for risk-free rate data)
# Get at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Polygon.io (optional, $29/mo for options historical data)
# Significantly improves backtesting with real options prices
POLYGON_API_KEY=your_polygon_api_key_here
